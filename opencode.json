{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 3,
  "model": "opencode/nemotron-3.5-lightning-free",
  "agent": {
    "orchestrator": {
      "mode": "subagent",
      "model": "opencode/nemotron-3.5-lightning-free",
      "description": "Orquestador central: descompone objetivo, lanza subagentes en paralelo, valida con pytest, itera (max 3), commitea, persiste estado",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "allow"
        },
        "skill": "allow"
      },
      "temperature": 0.1
    },
    "architect": {
      "mode": "subagent",
      "model": "opencode/nemotron-3.5-lightning-free",
      "description": "Diseño de arquitectura, interfaces, contratos, selectores UIA",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      },
      "temperature": 0.1
    },
    "impl-excel-manager": {
      "mode": "subagent",
      "model": "opencode/nemotron-3.5-lightning-free",
      "description": "Implementa ExcelManager: open_file, save_as, logging",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      },
      "temperature": 0.2
    },
    "impl-file-explorer": {
      "mode": "subagent",
      "model": "opencode/nemotron-3.5-lightning-free",
      "description": "Implementa FileExplorer: diálogos Windows, modal reemplazo",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      },
      "temperature": 0.2
    },
    "test-writer": {
      "mode": "subagent",
      "model": "opencode/mimo-v2.5-free",
      "description": "Escribe tests pytest para TC01, TC02, fixtures, mocking",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      },
      "temperature": 0.3
    },
    "reviewer": {
      "mode": "subagent",
      "model": "opencode/nemotron-3.5-lightning-free",
      "description": "Audita: no sleep, no Tab, pathlib, logging, SOLID, anti-fragilidad",
      "permission": {
        "edit": "deny",
        "bash": "allow"
      },
      "temperature": 0.1
    },
    "git-manager": {
      "mode": "subagent",
      "model": "opencode/mimo-v2.5-free",
      "description": "Conventional commits, PR, sync fork, version bump, changelog",
      "permission": {
        "edit": "allow",
        "bash": {
          "git *": "allow",
          "gh *": "allow"
        }
      },
      "temperature": 0.2
    }
  },
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "task": "allow",
    "skill": "allow"
  }
}